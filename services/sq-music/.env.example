# Add these keys to the repository root .env, then chmod 600 .env.
TZ=Asia/Shanghai
# Absolute host paths. Staging must be separate from the final library.
SQ_STAGING_PATH=/srv/apple-music-downloader/sq-staging
SQ_MYSQL_DATA_PATH=/srv/apple-music-downloader/sq-mysql
SQ_AUTH_PATH=/srv/apple-music-downloader/secrets/sq-auth.json
SQ_HOST_PORT=18099
AMDL_UNIFIED_MUSIC_ENABLED=false
AMDL_SQ_MUSIC_ENABLED=false
AMDL_SQ_MUSIC_SOURCES=netease

# Build with Dockerfile, then pin the result to a digest or local image ID.
SQ_PATCHED_IMAGE=REPLACE_WITH_PATCHED_IMAGE_ID_OR_DIGEST
# Baseline only: do not perform an in-place MySQL major upgrade.
SQ_MYSQL_IMAGE=REPLACE_WITH_AUDITED_MYSQL_5_7_DIGEST
# Upstream baseline is sqdockler/netease_cloud_music_api:v4.32.0.
SQ_NETEASE_IMAGE=registry.cn-hangzhou.aliyuncs.com/sqdockler/netease_cloud_music_api@sha256:87e4c7bf459da928309fd3c8840142f0f005b6a0f8812f5360acb3eac1e8553c

# bootstrap.py generates independent random values for these placeholders.
SQ_DB_PASSWORD=GENERATE_LOCALLY
SQ_DB_ROOT_PASSWORD=GENERATE_LOCALLY
SQ_JWT_SECRET=GENERATE_LOCALLY
