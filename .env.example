# Copy to .env and chmod 600 .env. Never commit the completed file.
# The installer keeps its private env outside the source checkout.
PRIVATE_ENV_FILE=.env
COMPOSE_PROJECT_NAME=apple-music-downloader
BOT_IMAGE=apple-music-downloader-bot:local
# Optional, pinned SABR prerelease tool; build and runtime opt-ins are separate.
INSTALL_YT_SABR=false
VM_IMAGE=apple-music-downloader-vm:local
PO_PROVIDER_IMAGE=brainicism/bgutil-ytdlp-pot-provider:2.0.2
AUTH_BROWSER_IMAGE=lscr.io/linuxserver/chromium:latest
TZ=Asia/Shanghai
# Use host-local storage outside a Git checkout and outside cloud sync.
STATE_PATH=/srv/apple-music-downloader/state
WRAPPER_SESSION_PATH=/srv/apple-music-downloader/wrapper-session
VM_DATA_PATH=/srv/apple-music-downloader/vm
MUSIC_PATH=/srv/media/apple-music
YOUTUBE_MUSIC_PATH=/srv/media/youtube-music
YOUTUBE_VIDEO_PATH=/srv/media/youtube-video
BILIBILI_MUSIC_PATH=/srv/media/bilibili-music
BILIBILI_VIDEO_PATH=/srv/media/bilibili-video
YOUTUBE_BROWSER_PATH=/srv/apple-music-downloader/youtube-browser
BILIBILI_BROWSER_PATH=/srv/apple-music-downloader/bilibili-browser
BOT_HEALTH_PORT=30871
VM_MANAGER_PORT=18080
VM_SSH_HOST_PORT=22221
YOUTUBE_BROWSER_PORT=31011
BILIBILI_BROWSER_PORT=31012
PUID=1000
PGID=1000

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_PROXY_URL=
TELEGRAM_API_BASE_URL=https://api.telegram.org
SYNOLOGY_CHAT_ENABLED=false
SYNOLOGY_CHAT_OUTGOING_TOKEN=
SYNOLOGY_CHAT_INCOMING_WEBHOOK_URL=
SYNOLOGY_CHAT_ALLOWED_USER_IDS=
AMDL_DOWNLOAD_PROXY_URL=
YT_DOWNLOAD_PROXY_URL=
BILI_DOWNLOAD_PROXY_URL=
AMDL_LANGUAGE=zh-CN
YT_ENABLED=true
YT_SABR_FALLBACK_ENABLED=false
YT_SABR_TOOL_PATH=/app/vendor/yt-dlp-sabr/yt-dlp
YT_STATE_DIR=/state/youtube
YT_TEMP_PATH=/state/youtube/tmp
YT_COOKIES_PATH=/state/youtube/cookies.txt
YT_AUTH_BROWSER_PROFILE_PATH=/youtube-auth-browser/.config/chromium/Default
YT_AUTH_BROWSER_CONTAINER_NAME=apple-music-downloader-youtube-auth-browser
# Leave the large-download proxy blank to use the ordinary download route.
YT_LARGE_DOWNLOAD_PROXY_URL=
YT_LARGE_DOWNLOAD_THRESHOLD_MIB=500
YT_DOWNLOAD_SIZE_PROBE_TIMEOUT_SECONDS=300
YT_PO_TOKEN_ENABLED=true
YT_PO_TOKEN_PROVIDER_URL=http://youtube-pot:4416
YT_PLAYER_CLIENT=mweb
YT_PLAYLIST_MAX_ITEMS=50
YT_PROBE_TIMEOUT_SECONDS=60
YT_DOWNLOAD_TIMEOUT_SECONDS=21600
YT_AUTH_RETRY_DELAY_SECONDS=2
YT_HIGH_QUALITY_RETRY_DELAY_SECONDS=60
YT_HIGH_QUALITY_RETRY_MAX_CYCLES=2
YT_AUTH_AUTO_REFRESH_DISABLED=false
YT_AUTH_AUTO_REFRESH_SETTLE_SECONDS=50
YT_REQUIRED_COOKIE_NAMES=SID,HSID,SSID,APISID,SAPISID,LOGIN_INFO,__Secure-1PSID,__Secure-3PSID
YT_BEETS_ENABLED=true
YT_LRC_ENABLED=true
YT_LRCLIB_URL=https://lrclib.net/api/search
# Video streams are remuxed, not transcoded; 0 means no height cap.
YT_VIDEO_MAX_HEIGHT=0
YT_VIDEO_FORMAT_SORT=res,fps,hdr,quality,lang,tbr,vcodec,channels,acodec,asr
YT_VIDEO_MERGE_FORMAT=mkv
# Manual/automatic subtitles are published as external SRT/ASS sidecars.
YT_AUTOMATIC_SUBTITLE_LANGUAGES=zh-Hans,zh-Hant,zh-CN,zh-TW,zh-HK,zh,en-orig,en,.*-orig
YT_SUBTITLE_DOWNLOAD_TIMEOUT_SECONDS=900
YT_SUBTITLE_SLEEP_SECONDS=2
YT_SUBTITLE_RATE_LIMIT_RETRIES=4
YT_SUBTITLE_RATE_LIMIT_RETRY_SECONDS=60
YT_BILINGUAL_CHINESE_FONT=Noto Sans CJK SC
YT_BILINGUAL_ENGLISH_FONT=Liberation Sans
YT_BILINGUAL_CHINESE_SIZE=68
YT_BILINGUAL_ENGLISH_SIZE=42
YT_BILINGUAL_MARGIN_V=64
YT_BILINGUAL_MARGIN_H=96
YT_BILINGUAL_SAFE_WIDTH=1728
YT_BILINGUAL_CUE_GAP_MS=80
ONLINE_MEDIA_THUMBNAIL_TIMEOUT_SECONDS=45
ONLINE_MEDIA_THUMBNAIL_MAX_BYTES=26214400
BILI_ENABLED=true
YT_OUTPUT_UID=1000
YT_OUTPUT_GID=1000
YT_OUTPUT_FILE_MODE=0664
YT_OUTPUT_DIR_MODE=0775
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=
EMBY_URL=
EMBY_USER=
EMBY_PASSWORD=
EMBY_METADATA_SYNC_ENABLED=false
EMBY_METADATA_SYNC_TIMEOUT_SECONDS=120
EMBY_YOUTUBE_LIBRARY_PATH=/video/YouTube
YT_LRCAPI_URL=
AMDL_LX_FALLBACK_ENABLED=false
AMDL_LX_FALLBACK_BASE_URL=http://lxserver:9527
AMDL_LX_FALLBACK_AUTH_FILE=/run/secrets/lx-frontend-auth
AMDL_LX_FALLBACK_OUTPUT_PATH=/music/LX Music
AMDL_LX_FALLBACK_SERVER_MUSIC_ROOT=/server/music/_open
AMDL_LX_FALLBACK_ALLOW_320=true
AMDL_LX_FALLBACK_ALLOW_CATALOG_API_3076=true
AMDL_LX_FALLBACK_METADATA_COUNTRIES=CN,HK,TW,SG,US
AMDL_LX_FALLBACK_SEARCH_SOURCES=kw,tx,wy,mg,kg
AMDL_LX_FALLBACK_REQUEST_TIMEOUT_SECONDS=30
AMDL_LX_FALLBACK_QUEUE_TIMEOUT_SECONDS=1800
AMDL_LX_FALLBACK_POLL_SECONDS=2
AMDL_LX_FALLBACK_MAX_CANDIDATES=20
AMDL_LX_SEARCH_PAGE_SIZE=6
AMDL_LX_SEARCH_MAX_RESULTS=80

# Optional LX/SQ service overlays are selected with --profile lx / --profile sq.
# Follow docs/MUSIC_SOURCES.zh-CN.md before enabling unified lossless routing.
AMDL_UNIFIED_MUSIC_ENABLED=false
AMDL_UNIFIED_SEARCH_TIMEOUT_SECONDS=25
AMDL_SQ_MUSIC_ENABLED=false
AMDL_SQ_MUSIC_BASE_URL=http://sqmusic-server:8099
AMDL_SQ_AUTH_FILE=/run/secrets/sq-auth.json
AMDL_SQ_MUSIC_STAGING_PATH=/sq-staging
AMDL_SQ_MUSIC_OUTPUT_PATH=/music/SQ Music
AMDL_SQ_MUSIC_SERVER_ROOT=/music
AMDL_SQ_MUSIC_SOURCES=netease
LX_IMAGE=ghcr.io/xcq0607/lxserver@sha256:aa3db966049584585639ca6563e85ce5b7ebf33569dd1f5064c21bd7330382af
LX_DATA_PATH=/srv/apple-music-downloader/lx-music
LX_HOST_PORT=19527
LX_FRONTEND_AUTH_PATH=/srv/apple-music-downloader/secrets/lx-frontend-auth
SQ_PATCHED_IMAGE=apple-music-downloader-sq:3.1.33-bot
SQ_MYSQL_IMAGE=mysql:5.7.44
SQ_NETEASE_IMAGE=registry.cn-hangzhou.aliyuncs.com/sqdockler/netease_cloud_music_api@sha256:87e4c7bf459da928309fd3c8840142f0f005b6a0f8812f5360acb3eac1e8553c
SQ_STAGING_PATH=/srv/apple-music-downloader/sq-staging
SQ_MYSQL_DATA_PATH=/srv/apple-music-downloader/sq-mysql
SQ_AUTH_PATH=/srv/apple-music-downloader/secrets/sq-auth.json
SQ_HOST_PORT=18099
# Generate private values with the SQ bootstrap helper; never publish .env.
SQ_DB_PASSWORD=
SQ_DB_ROOT_PASSWORD=
SQ_JWT_SECRET=

# First boot uses manager mode so an operator can log in using upstream tools.
# After creating a wrapper instance, supply your own device descriptor and set true.
WRAPPER_SINGLE_ENABLE=false
WRAPPER_DEVICE_INFO=
WRAPPER_MANAGER_PROXY=
WRAPPER_MANAGER_MIRROR=false
VM_MEMORY=4096
VM_CPUS=2
VM_DISK_SIZE=32G
UBUNTU_IMAGE_URL=https://cloud-images.ubuntu.com/releases/noble/release-20261017/ubuntu-24.04-server-cloudimg-amd64.img
# Fixed release, verified against the official SHA256SUMS.
UBUNTU_IMAGE_SHA256=04e8f2461a16a44e78a370284471f29616cdd9baf1893df25807b71f985b6c94

# Enable the lyrics profile only after provisioning the model files below.
AMDL_WORD_LYRICS_ENABLED=true
AMDL_WORD_LYRICS_AUTOMATION_ENABLED=false
AMDL_WORD_LYRICS_COMPLETION_ENABLED=false
WORD_LYRICS_NAS_THREADS=4
WORD_LYRICS_NAS_WHISPER_MODEL=/state/word-lyrics/models/ggml-large-v3-turbo-q5_0.bin
WORD_LYRICS_NAS_WHISPER_MODEL_SHA1=e050f7970618a659205450ad97eb95a18d69c9ee
WORD_LYRICS_NAS_FALLBACK_MODEL=/state/word-lyrics/models/ggml-large-v3-q5_0.bin
WORD_LYRICS_MAC_FALLBACK_ENABLED=false

# Browser sessions are private. Optional auto-auth needs the Docker socket
# override in compose.auth-refresh.yaml (or compose.self-heal.yaml).
# Either override grants the bot host-level Docker access.
ONLINE_AUTH_AUTO_REFRESH_ENABLED=false
ONLINE_AUTH_AUTO_REFRESH_STATE_DIR=/state/auth-refresh
ONLINE_AUTH_AUTO_REFRESH_SETTLE_SECONDS=12
ONLINE_AUTH_BROWSER_READY_TIMEOUT_SECONDS=60
ONLINE_AUTH_EXPORT_TIMEOUT_SECONDS=240
ONLINE_AUTH_SUCCESS_COOLDOWN_SECONDS=300
ONLINE_AUTH_FAILURE_COOLDOWN_SECONDS=1800
DOCKER_SOCKET_PATH=/var/run/docker.sock
YOUTUBE_BROWSER_ARGS=--password-store=basic https://www.youtube.com/robots.txt
BILIBILI_BROWSER_ARGS=--password-store=basic https://www.bilibili.com/robots.txt
